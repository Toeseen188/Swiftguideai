# Backend service port
PORT=3001

# AI key (Anthropic / Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Feature toggle: fetch live Montgomery open data instead of mock
USE_REAL_DATA=true

# Frontend base URL for API calls
REACT_APP_API_URL=http://localhost:3001

# (supabase/brightdata no longer required)
# REACT_APP_SUPABASE_URL=your_supabase_project_url
# REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key
# REACT_APP_BRIGHTDATA_API_KEY=your_brightdata_api_key (optional)

